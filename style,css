body{
margin:0;
font-family:Arial;
background:#eceff4;
}

header{

height:100vh;

background:
linear-gradient(rgba(0,0,0,.6),rgba(0,0,0,.6)),
url(https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1600);

background-size:cover;

color:white;

}

nav{

display:flex;

justify-content:space-between;

padding:20px 10%;

background:rgba(0,0,0,.3);

backdrop-filter:blur(12px);

}

nav ul{

display:flex;

gap:30px;

list-style:none;

}

.hero{

text-align:center;

margin-top:180px;

}

.hero h1{

font-size:60px;

}

.hero a{

background:#ff3d00;

padding:15px 40px;

color:white;

text-decoration:none;

border-radius:30px;

}

.estatisticas{

display:grid;

grid-template-columns:repeat(4,1fr);

padding:50px;

background:#111;

color:white;

text-align:center;

}

.numero h2{

font-size:50px;

color:#ff9800;

}

.container{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(340px,1fr));

gap:30px;

padding:40px;

}

.card{

background:white;

border-radius:20px;

overflow:hidden;

box-shadow:0 15px 30px rgba(0,0,0,.15);

transition:.4s;

}

.card:hover{

transform:translateY(-10px);

}

.card img{

width:100%;

height:250px;

object-fit:cover;

}

.info{

padding:20px;

}

.barra{

height:25px;

background:#ddd;

border-radius:30px;

overflow:hidden;

margin:15px 0;

}

.barra div{

height:100%;

background:linear-gradient(90deg,#00c853,#00e676);

text-align:center;

color:white;

font-weight:bold;

}

button{

background:#ff1744;

color:white;

border:none;

padding:12px 25px;

border-radius:30px;

cursor:pointer;

}

table{

width:90%;

margin:auto;

border-collapse:collapse;

background:white;

}

th{

background:#0d47a1;

color:white;

padding:15px;

}

td{

padding:15px;

text-align:center;

}

tr:nth-child(even){

background:#eeeeee;

}

footer{

background:#111;

color:white;

padding:40px;

text-align:center;

}