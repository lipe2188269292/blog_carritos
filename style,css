*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f5f5f5;
}

header{

    background:linear-gradient(90deg,#000428,#004e92);
    color:white;
    text-align:center;
    padding:50px;
}

header h1{

    font-size:50px;
    margin-bottom:10px;
}

header p{

    font-size:20px;
    color:#ddd;
}

.pesquisa{

    text-align:center;
    margin:30px;
}

.pesquisa input{

    width:350px;
    max-width:90%;
    padding:15px;
    border:none;
    border-radius:30px;
    font-size:18px;
    box-shadow:0 5px 10px rgba(0,0,0,.2);
}

.container{

    width:90%;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
    gap:30px;
    margin-bottom:50px;
}

.card{

    background:white;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 10px 20px rgba(0,0,0,.15);
    transition:.4s;
}

.card:hover{

    transform:translateY(-10px);
}

.card img{

    width:100%;
    height:230px;
    object-fit:cover;
}

.conteudo{

    padding:20px;
}

.conteudo h2{

    color:#004e92;
    margin-bottom:10px;
}

.conteudo p{

    color:#555;
    margin-bottom:20px;
    line-height:1.6;
}

.like{

    background:#ff3d3d;
    color:white;
    border:none;
    padding:12px 22px;
    border-radius:30px;
    cursor:pointer;
    transition:.3s;
    font-size:16px;
}

.like:hover{

    background:#c70039;
}